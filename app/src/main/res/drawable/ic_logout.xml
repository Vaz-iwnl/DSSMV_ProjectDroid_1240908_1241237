<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">

    <!-- Cor de fundo do botão/caixa -->
    <solid android:color="#FF5722" />

    <!-- Raio dos cantos (quanto maior, mais arredondado fica) -->
    <corners android:radius="12dp" />

    <!-- Opcional: Margens internas (Padding) -->
    <padding
            android:left="16dp"
            android:top="12dp"
            android:right="16dp"
            android:bottom="12dp" />

</shape>